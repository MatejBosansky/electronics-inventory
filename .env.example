# Copy to .env and adjust. All values are optional.

# Port on the host and the address to listen on (0.0.0.0 = all interfaces).
INVENTORY_PORT=8080
INVENTORY_BIND=0.0.0.0

# Folder with the database (inventory.json, images/, backups/).
INVENTORY_DATA=./data

# Owner of the files written into the data folder — use the output of `id -u` and `id -g`.
PUID=1000
PGID=1000

# Optional HTTP basic auth (app, REST API and MCP). Strongly recommended when the port is reachable
# from the internet.
AUTH_USER=
AUTH_PASSWORD=

# Address used in links returned by the API (e.g. http://server:8080). Optional; by default the
# address of the request is used.
INVENTORY_PUBLIC_URL=
